{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AICAGE package list",
  "type": "object",
  "required": ["distro", "resolvers"],
  "properties": {
    "distro": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "resolvers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^scripts/packages/([^/]+)/versions\\.sh$"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[0-9]{2}-[a-z0-9][a-z0-9-]*$"
        },
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    }
  },
  "additionalProperties": false
}
