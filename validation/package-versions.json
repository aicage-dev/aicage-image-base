{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AICAGE package versions",
  "type": "object",
  "required": ["packages"],
  "properties": {
    "packages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[^=\\s]+=.*\\S.*"
        }
      }
    }
  },
  "additionalProperties": false
}
